---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              作品集
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 gap-y-6 sm:auto-rows-fr sm:grid-cols-2 sm:gap-x-10 sm:gap-y-8">
              {siteConfig.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const linkProps = project.link
                  ? {
                      href: project.link.startsWith("http") ? project.link : `${import.meta.env.BASE_URL}${project.link}`,
                      target: project.link.startsWith("http") ? "_blank" : undefined,
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <div class="group relative min-w-0">
                    <span
                      class="absolute right-full top-3 mr-2 text-sm font-mono"
                      style={{ color: siteConfig.accentColor }}
                    >
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <Component
                      {...linkProps}
                      class={`block relative h-full p-4 xl:p-5 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                        project.link
                          ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                          : ""
                      }`}
                    >
                      {project.link && (
                        <div class="absolute top-4 right-4 xl:top-5 xl:right-5 size-9 sm:size-10 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                          <svg
                            class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      {"cover" in project && project.cover ? (
                        <img
                          src={`${import.meta.env.BASE_URL}${project.cover}`}
                          alt={project.name}
                          width="1920"
                          height="1080"
                          loading="lazy"
                          decoding="async"
                          class="block w-full h-auto rounded-lg mb-4"
                        />
                      ) : (
                        <div class="aspect-video rounded-lg bg-gray-200 mb-4" aria-hidden="true" />
                      )}
                      <div class="space-y-3">
                        <div>
                          <h3 class="text-lg xl:text-xl font-bold text-gray-900">
                            {project.name}
                          </h3>
                        </div>

                        <p
                          class="text-sm xl:text-base text-gray-600 leading-relaxed"
                        >
                          {project.description}
                        </p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                  project.link ? "group-hover:bg-gray-800" : ""
                                }`}
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
