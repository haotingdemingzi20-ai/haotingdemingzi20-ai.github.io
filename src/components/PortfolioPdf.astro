---
const filename = "杨舒茜作品集-两段实习可实习六个月立刻到岗.pdf";
const pdfUrl = `${import.meta.env.BASE_URL}${encodeURIComponent(filename)}`;
---

<section
  id="portfolio-pdf"
  aria-labelledby="portfolio-pdf-title"
  class="px-8 pb-8 sm:px-12 sm:pb-12 md:px-16 md:pb-16 lg:px-24 lg:pb-24"
>
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <h2 id="portfolio-pdf-title" class="text-2xl font-bold text-gray-900 sm:text-3xl">
      作品集 PDF
    </h2>
    <div class="flex flex-wrap items-center gap-3">
      <a
        href={`${pdfUrl}#toolbar=0&navpanes=0`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-semibold text-gray-900 hover:bg-gray-100"
      >
        预览 PDF
      </a>
      <a
        href={pdfUrl}
        download={filename}
        class="inline-flex items-center rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-700"
      >
        下载 PDF
      </a>
    </div>
  </div>
</section>
