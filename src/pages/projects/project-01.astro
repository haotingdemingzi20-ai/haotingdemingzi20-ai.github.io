---
import { siteConfig } from "../../config";
import "../../styles/global.css";
const base = import.meta.env.BASE_URL;
const captions = [
  "封面",
  "项目背景",
  "我的工作与制作流程",
  "漫画改编",
  "角色参考与镜头制作",
  "分镜设计",
  "分镜画面展示",
  "分镜画面修正",
  "后期剪辑与成片",
  "角色内容运营",
  "项目账号展示",
  "实习总结",
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="2026 年全品暑期实习项目，涵盖漫画改编、分镜设计、视频制作与科普内容运营。" />
    <title>全品《漫画学课本》视频化改编与 IP 内容延展 · {siteConfig.name}</title>
  </head>
  <body class="bg-[#101112] text-white">
    <header class="border-b border-white/10">
      <div class="max-w-[1440px] mx-auto px-5 sm:px-8 py-5 flex items-center justify-between gap-4">
        <a href={`${base}#projects`} class="text-sm text-gray-300 hover:text-white focus-visible:outline-2 focus-visible:outline-orange-500">← 返回作品集</a>
        <span class="text-sm text-gray-400">{siteConfig.name} · 作品一</span>
      </div>
    </header>
    <main class="max-w-[1440px] mx-auto">
      <h1 class="sr-only">全品《漫画学课本》视频化改编与 IP 内容延展</h1>
      <div class="flex flex-col" aria-label="第一个项目的 12 张作品图片，按 1 至 12 顺序从上到下竖向排列">
        {captions.map((caption, index) => (
          <figure class="m-0 w-full">
            <a
              href={`${base}projects/project-01/${index + 1}.png`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`查看第 ${index + 1} 页原图：${caption}`}
              class="block focus-visible:outline-2 focus-visible:outline-orange-500 focus-visible:outline-offset-[-2px]"
            >
              <img
                src={`${base}projects/project-01/${index + 1}.png`}
                alt={`第 ${index + 1} 页：${caption}`}
                width="1920"
                height="1080"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                class="block w-full h-auto"
              />
            </a>
            <figcaption class="sr-only">{index + 1} / 12 · {caption}</figcaption>
          </figure>
        ))}
      </div>
    </main>
    <footer class="text-center px-5 py-10 border-t border-white/10">
      <p class="text-gray-400 text-sm mb-5">01 · 全品《漫画学课本》视频化改编与 IP 内容延展 · 共 12 页</p>
      <a href={`${base}#projects`} class="inline-block rounded-full border border-white/30 px-6 py-3 text-sm hover:bg-white hover:text-black">返回作品集</a>
    </footer>
  </body>
</html>
